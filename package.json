{
  "name": "@luocfprime/slidev-theme-ustc",
  "version": "0.1.5",
  "type": "module",
  "description": "A clean academic Slidev theme for USTC presentations",
  "keywords": [
    "slidev-theme",
    "slidev",
    "USTC",
    "academic"
  ],
  "files": [
    "assets",
    "components",
    "layouts",
    "public",
    "setup",
    "styles",
    "utils",
    "global-top.vue"
  ],
  "engines": {
    "node": ">=18.0.0",
    "slidev": ">=52.0.0"
  },
  "scripts": {
    "dev": "slidev example.md --open",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "preview": "slidev build example.md --base /slidev-theme-ustc/ && python3 serve.py"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@myriaddreamin/typst-ts-node-compiler": "^0.6.0",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1",
    "plotly.js-dist": "^3.5.0",
    "qrcode.vue": "^3.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@slidev/cli": "^52.14.2",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "vite": "^7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "slidev": {
    "colorSchema": "light",
    "highlighter": "all",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1280,
      "lineNumbers": true,
      "fonts": {
        "mono": "Fira Code",
        "sans": "Inter,Avenir Next,Nunito Sans",
        "local": "Avenir Next"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luocfprime/slidev-theme-ustc.git"
  },
  "author": "luocfprime",
  "bugs": {
    "url": "https://github.com/luocfprime/slidev-theme-ustc/issues"
  },
  "homepage": "https://github.com/luocfprime/slidev-theme-ustc#readme"
}
